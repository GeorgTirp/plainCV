universe   = vanilla
initialdir = /home/gtirpitz/plainCV

executable = nc_train_lm.sh
arguments  = config/seed_sweep/lm_hadamard_signum_seeds.yaml _ ggn

environment = "JOB_IDX=0"

output = job_outputs/GGN_hadamard_signum_s0.$(Cluster).$(Process).out
error  = job_outputs/GGN_hadamard_signum_s0.$(Cluster).$(Process).err
log    = job_outputs/GGN_hadamard_signum_s0.$(Cluster).log

request_cpus   = 4
request_memory = 16384
request_gpus   = 1
min_gpu_mem_mb = 80000
requirements   = (TARGET.CUDAGlobalMemoryMb >= $(min_gpu_mem_mb)) \
                 && !regexp("^(g146|g193|g194|g195)\\.", Machine)

getenv = True

+JobBatchName = "ggn-seed-sweep"

MaxTime = 129600

periodic_hold = (JobStatus == 2) && ((CurrentTime - JobCurrentStartDate) >= $(MaxTime))
periodic_hold_reason = "Job runtime exceeded MaxTime"

# nc_train_lm.sh exits 42 when JAX cannot see a GPU (it refuses to burn cluster
# time training on CPU). Put the job back in the queue on that code so it retries
# on a healthy node; every other exit code is final.
on_exit_remove = (ExitBySignal == true) || (ExitCode =!= 42)

queue 1
