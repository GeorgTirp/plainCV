# Generated by run_all_tuning.sh -- do not edit by hand.
# lm / soap tuning sweep, 16 runs in project tune-soap-lm-fwedu-16.
universe   = vanilla
initialdir = /home/gtirpitz/plainCV

executable = nc_wandb_agent_lm.sh
arguments  = geotir-university-of-t-bingen/tune-soap-lm-fwedu-16/wdldi158 4

output = job_outputs/lm_tune_soap.$(Cluster).$(Process).out
error  = job_outputs/lm_tune_soap.$(Cluster).$(Process).err
log    = job_outputs/lm_tune_soap.$(Cluster).log

request_cpus   = 4
request_memory = 12288
request_gpus   = 1
min_gpu_mem_mb = 80000
requirements   = (TARGET.CUDAGlobalMemoryMb >= $(min_gpu_mem_mb)) \
                 && !regexp("^(g106|g146|g174|g193|g194|g195)[.]", Machine)

getenv = True

+JobBatchName = "lm-tune-soap"

MaxTime = 129600

periodic_hold = (JobStatus == 2) && ((CurrentTime - JobCurrentStartDate) >= $(MaxTime))
periodic_hold_reason = "Job runtime exceeded MaxTime"

# The agent wrapper exits 42 when it lands on a node with broken GPUs. Keep the
# job in the queue in that case so it is rematched somewhere healthy, but give
# up after 10 attempts rather than looping forever.
on_exit_remove = (ExitBySignal == true) || (ExitCode =!= 42)
periodic_remove = (NumJobStarts > 10)

queue 4
